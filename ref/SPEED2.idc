	set_func_cmt(0X54E6E0,	"Sets buttons and background of the help bar, updates profile name display.\nSee {enum PCHELPBARFLAGS} |||ref\nMask gets adjusted based on {83A9D0.156A8} and {8654A4}: ||| ref,ref\n\n.controlchars [] .pushmode pre\nif (([83A9D0.156A8] == [enum MENU_STATE/8] || [83A9D0.156A8] == [enum MENU_STATE/100]) && [8654A4] == 3 && (mask & BUTTON_PC_NAV_QUIT)) { ||| ref,ref,ref,ref,ref\n        mask = (mask & ~PC_NAV_QUIT) | BUTTON_PC_NAV_LOGOFF;\n}\nif ([83A9D0.156A8] == [enum MENU_STATE/200] && (mask & BUTTON_PC_NAV_EA_MESSENGER)) { ||| ref,ref\n        mask &= ~BUTTON_PC_NAV_EA_MESSENGER;\n}\n.controlchars {} .popmode pre", 0);
